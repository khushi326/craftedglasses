# Frontend environment variables example
# Copy this file to .env and set the appropriate API base URL for the backend.
# Local development (optional — Vite already proxies /api to localhost:5002):
# VITE_API_BASE_URL=http://localhost:5002/api
#
# Production / Vercel:
VITE_API_BASE_URL=https://craftedglasses-backend.onrender.com/api
