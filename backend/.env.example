# Backend environment variables example
# Copy this file to .env and fill in the actual values.

PORT=5002
NODE_ENV=development
# MongoDB connection string. Replace <username>, <password>, and <cluster> with your Atlas credentials.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/craftedglasses?retryWrites=true&w=majority
# URL of the frontend application (used for CORS)
CLIENT_URL=https://craftedglasses.vercel.app
# Secret for signing JWT tokens. Use a strong random string.
JWT_SECRET=<your_jwt_secret>
# Admin credentials (optional, for initial admin login)
ADMIN_USERNAME=admin@example.com
ADMIN_PASSWORD=adminpassword
